# Copy this file to .env (never committed) next to package.json.
# `npm start` and the systemd unit load it with --env-file-if-exists=.env.
# Every value here overrides the matching key in settings.json.

# AWS Polly text-to-speech (read by the AWS SDK's default credential chain)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Polly voice and engine (engine: neural | standard | long-form | generative)
SONOS_POLLY_VOICE=Joanna
SONOS_POLLY_ENGINE=neural

# HTTP server
#SONOS_HTTP_PORT=5005
#SONOS_HTTP_IP=0.0.0.0
#SONOS_HTTP_SECURE_PORT=5006
#SONOS_HTTP_AUTH_USERNAME=
#SONOS_HTTP_AUTH_PASSWORD=

# Sonos
#SONOS_HOUSEHOLD=
# Comma-separated player IPs for networks where SSDP multicast cannot reach the players
#SONOS_DISCOVERY_HOSTS=192.168.2.230
#SONOS_ANNOUNCE_VOLUME=40
#SONOS_WEBHOOK_URL=

# Music services
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SOUNDCLOUD_CLIENT_ID=

# Logging: trace | debug | info | warn | error ; format: pretty | json
#LOG_LEVEL=info
#LOG_FORMAT=pretty
