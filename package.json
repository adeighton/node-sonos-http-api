{
  "name": "sonos-http-api",
  "version": "2.0.0",
  "description": "HTTP API for controlling a Sonos system (personal fork of jishi/node-sonos-http-api, modernized for Node 24 and TypeScript)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jimmy Shimizu <jimmy@shimizu.se>",
  "contributors": [
    "Anthony Deighton"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adeighton/node-sonos-http-api.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "node --watch server.cjs",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "test:watch": "node --disable-warning=ExperimentalWarning --test --watch 'src/**/*.test.ts'",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/testing/**' --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=85 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1127.0",
    "@hono/node-server": "^2.1.1",
    "basic-auth": "^2.0.1",
    "fuse.js": "^7.5.0",
    "hono": "^4.13.7",
    "html-entities": "^2.6.0",
    "json5": "^2.2.3",
    "music-metadata": "^11.15.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "request-promise": "^4.2.6",
    "serve-static": "^1.16.3",
    "sonos-discovery": "file:./lib/sonos-discovery",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/xml-flow": "^1.0.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
